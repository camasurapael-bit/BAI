rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }

    match /appointments/{id} {
      function mine() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.uid == request.auth.uid;
      }
      function curStatus() { return resource.data.get('status', 'pending'); }
      function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

      // Guests create their own booking (no status field: the admin sets it).
      // The admin can also create bookings (phone / walk-in).
      allow create: if request.auth != null
        && (isAdmin() || request.auth.token.email_verified == true)
        && request.resource.data.uid == request.auth.uid
        && (isAdmin() || !('status' in request.resource.data))
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1 && request.resource.data.guests <= 50
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 100;

      // Guests read only their own bookings; the admin reads all.
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow delete: if isAdmin();

      allow update: if isAdmin()

        // 1) guest reschedules own pending/confirmed booking (max 2 times); it returns to "pending"
        || (mine()
          && curStatus() in ['pending', 'confirmed']
          && resource.data.get('rescheduleCount', 0) < 2
          && onlyKeys(['apptDate', 'apptTime', 'status', 'rescheduledAt', 'rescheduleCount'])
          && request.resource.data.status == 'pending'
          && request.resource.data.apptDate is string && request.resource.data.apptDate.size() == 10
          && request.resource.data.apptTime is string
          && request.resource.data.apptTime >= '07:00' && request.resource.data.apptTime <= '20:00'
          && request.resource.data.rescheduleCount == resource.data.get('rescheduleCount', 0) + 1
          && request.resource.data.rescheduledAt == request.time)

        // 2) guest cancels own pending/confirmed booking
        || (mine()
          && curStatus() in ['pending', 'confirmed']
          && onlyKeys(['status', 'cancelledAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time)

        // 3) guest rates own completed booking once
        || (mine()
          && curStatus() == 'completed'
          && !('rating' in resource.data)
          && onlyKeys(['rating', 'review', 'ratedAt'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.review is string && request.resource.data.review.size() <= 500
          && request.resource.data.ratedAt == request.time);
    }

    // Availability (blocked dates + capacity): everyone can read, only the admin can change.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity log: admin only, append-only.
    match /auditLog/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
