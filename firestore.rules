rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }

    match /appointments/{id} {
      // Guests create their own booking (no status field: the admin sets it).
      // The admin can also create bookings (phone / walk-in).
      allow create: if request.auth != null
        && (isAdmin() || request.auth.token.email_verified == true)
        && request.resource.data.uid == request.auth.uid
        && (isAdmin() || !('status' in request.resource.data))
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1 && request.resource.data.guests <= 50
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 100;

      // Guests read only their own bookings; the admin reads all.
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());

      // The admin can change anything and delete.
      allow delete: if isAdmin();

      // A verified guest can reschedule their OWN booking (max 2 times) while it is
      // pending or confirmed. Only date, time and bookkeeping fields may change, and the
      // booking goes back to "pending" so the hotel re-confirms it.
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.uid == request.auth.uid
        && resource.data.get('status', 'pending') in ['pending', 'confirmed']
        && resource.data.get('rescheduleCount', 0) < 2
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['apptDate', 'apptTime', 'status', 'rescheduledAt', 'rescheduleCount'])
        && request.resource.data.status == 'pending'
        && request.resource.data.apptDate is string && request.resource.data.apptDate.size() == 10
        && request.resource.data.apptTime is string
        && request.resource.data.apptTime >= '07:00' && request.resource.data.apptTime <= '20:00'
        && request.resource.data.rescheduleCount == resource.data.get('rescheduleCount', 0) + 1
        && request.resource.data.rescheduledAt == request.time
      );
    }
  }
}
